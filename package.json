{
  "name": "veilbreak",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "verify-client-only": "node scripts/verify-client-only.mjs",
    "generate-coverage": "pnpm --filter @veilbreak/content run generate-coverage",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm verify-client-only && pnpm verify-no-dev-mode",
    "sim": "pnpm --filter @veilbreak/ai run sim",
    "meta": "pnpm --filter @veilbreak/ai run meta",
    "verify-no-dev-mode": "node scripts/verify-no-dev-mode.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
